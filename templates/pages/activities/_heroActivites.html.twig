{# templates/activities/index.html.twig ou home/index.html.twig #}

{% set heroActivite = asset('medias/media.mp4') %}

<header class="position-relative d-flex align-items-center min-vh-75 mt-5 overflow-hidden" role="banner">
  
  {# Vidéo en arrière-plan #}
  <video 
    autoplay 
    muted 
    loop 
    playsinline
    class="position-absolute top-0 start-0 w-100 h-100"
    style="object-fit: cover; z-index: 0;"
  >
    <source src="{{ heroActivite }}" type="video/mp4">
    Votre navigateur ne supporte pas la vidéo HTML5.
  </video>

  {# Overlay sombre #}
  <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark" style="opacity: 0.5; z-index: 1;"></div>

  {# Contenu #}
  <div class="container position-relative py-5" style="z-index: 2;">
    <div class="row">
      <div class="col-12 col-lg-7">
        
        {# Card avec effet glass #}
        <div class="glass-card-white glass-border p-4 p-md-5 text-white">
          <h1 class="display-5 fw-bold mb-3">
            Découvrez nos activités
          </h1>
          
          <p class="lead mb-4" style="font-size: 1.1rem;">
            Circuit training en extérieur • Pilates • Stretching — séances individuelles et petits groupes.
          </p>
          
          <div class="d-flex gap-3 flex-wrap">
            <twig:Button 
              label="Découvrir le circuit"
              href="{{ path('app_activities') }}"
              variant="glass-brand"
              size="lg"
              class="rounded-pill px-4"
            />
            <twig:Button 
              label="Me contacter"
              href="{{ path('app_contact') }}"
              variant="glass-light"
              size="lg"
              class="rounded-pill px-4"
            />
          </div>
        </div>

      </div>
    </div>
  </div>
</header>