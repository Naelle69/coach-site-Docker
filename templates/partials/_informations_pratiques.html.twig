{# Bloc "Informations Pratiques" — mobile-first, Bootstrap only #}
<section
  id="infos-pratiques"
  class="py-5"
  style="background: var(--body-bg);"
  role="region"
  aria-labelledby="infos-pratiques-title"
  >
  <div class="container">
    <hr >
    <h2 id="infos-pratiques-title"
        class="text-center fw-bold fs-fluid-hero pt-4 mb-5"
        style="color: var(--primary-strong);">
      Informations Pratiques
    </h2>

    {# 1 col en mobile, 3 cols en ≥lg #}
    <div class="row row-cols-1 row-cols-lg-3 g-4 mb-4">

      {# Carte 1 #}
      <div class="col">
        <article class="card h-100 border rounded-4 shadow-sm" style="background: var(--surface);">
          <div class="card-body p-4">
            <h3 class="fs-fluid-lead fw-bold mb-3 text-text">Organisation & fonctionnement</h3>
            <ul class="list-unstyled m-0">
              <li class="d-flex gap-2 mb-2">
                <span class="pt-1" aria-hidden="true" style="color: var(--primary-2)">✓</span>
                <span><strong>Format :</strong> séances individuelles ou petits groupes</span>
              </li>
              <li class="d-flex gap-2 mb-2">
                <span class="pt-1" aria-hidden="true" style="color: var(--primary-2)">✓</span>
                <span><strong>Lieu :</strong> extérieur (parcs de Saint-Georges), domicile, intérieur</span>
              </li>
              <li class="d-flex gap-2 mb-2">
                <span class="pt-1" aria-hidden="true" style="color: var(--primary-2)">✓</span>
                <span><strong>Matériel :</strong> fourni (poids, élastiques, kettlebell, TRX…)</span>
              </li>
              <li class="d-flex gap-2">
                <span class="pt-1" aria-hidden="true" style="color: var(--primary-2)">✓</span>
                <span><strong>Fonctionnement :</strong> à la demande, sans inscription ni réservation en ligne</span>
              </li>
            </ul>
          </div>
        </article>
      </div>

      {# Carte 2 #}
      <div class="col">
        <article class="card h-100 border rounded-4 shadow-sm" style="background: var(--surface);">
          <div class="card-body p-4">
            <h3 class="fs-fluid-lead fw-bold mb-3 text-text">Zone d’intervention & accès</h3>
            <ul class="list-unstyled m-0">
              <li class="d-flex gap-2 mb-2">
                <span class="pt-1" aria-hidden="true" style="color: var(--primary-2)">✓</span>
                <span><strong>Quartier :</strong> Saint-Georges et alentours</span>
              </li>
              <li class="d-flex gap-2 mb-2">
                <span class="pt-1" aria-hidden="true" style="color: var(--primary-2)">✓</span>
                <span><strong>Extérieur :</strong> parcs (mobilier urbain, zones plates)</span>
              </li>
              <li class="d-flex gap-2 mb-2">
                <span class="pt-1" aria-hidden="true" style="color: var(--primary-2)">✓</span>
                <span><strong>Domicile / intérieur :</strong> sur demande</span>
              </li>
              <li class="d-flex gap-2">
                <span class="pt-1" aria-hidden="true" style="color: var(--primary-2);">✓</span>
                <span><strong>Transports :</strong> à compléter (bus, stationnement…)</span>
              </li>
            </ul>
          </div>
        </article>
      </div>

      {# Carte 3 #}
      <div class="col">
        <article class="card h-100 border rounded-4 shadow-sm" style="background: var(--surface);">
          <div class="card-body p-4">
            <h3 class="fs-fluid-lead fw-bold mb-3 text-text">Types de séances</h3>
            <ul class="list-unstyled m-0">
              <li class="d-flex gap-2 mb-2">
                <span class="pt-1" aria-hidden="true" style="color: var(--primary-2)">✓</span>
                <span>Collectifs (petits groupes)</span>
              </li>
              <li class="d-flex gap-2 mb-2">
                <span class="pt-1" aria-hidden="true" style="color: var(--primary-2)">✓</span>
                <span>Individuelles / Duo</span>
              </li>
              <li class="d-flex gap-2 mb-2">
                <span class="pt-1" aria-hidden="true" style="color: var(--primary-2)">✓</span>
                <span>Programmes en ligne (visio)</span>
              </li>
              <li class="d-flex gap-2">
                <span class="pt-1" aria-hidden="true" style="color: var(--primary-2)">✓</span>
                <span>Outdoor (circuit), Pilates, Stretching</span>
              </li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
