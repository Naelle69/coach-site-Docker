{# templates/admin/dashboard.html.twig #}
{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
  Bienvenue dans votre tableau de bord, {{ app.user.userIdentifier }}
{% endblock %}

{% block main %}
  <div class="row g-4">

    <div class="col-md-4">
      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body text-center">
          <h5 class="fw-semibold mb-2">Avis en attente</h5>
          <p class="display-6 text-warning fw-bold">{{ pendingCount }}</p>
        </div>
      </div>
    </div>

    {% if approvedCount is defined %}
      <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-4">
          <div class="card-body text-center">
            <h5 class="fw-semibold mb-2">Avis approuvés</h5>
            <p class="display-6 text-success fw-bold">{{ approvedCount }}</p>
          </div>
        </div>
      </div>
    {% endif %}

    <div class="col-md-4">
      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body text-center">
          <h5 class="fw-semibold mb-2">Accès rapide</h5>
          <a href="{{ reviewsUrl }}" class="btn btn-primary rounded-pill">Gérer les avis</a>
        </div>
      </div>
    </div>

  </div>
{% endblock %}
