
<!DOCTYPE html>
<html lang="fr" data-theme="energie" data-bs-theme="light">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000"> {# sera mis à jour par app.js #}
    <title>{% block title %}Coach Fitness{% endblock %}</title>

    {# Bootstrap CSS si tu l’utilises #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    {# ✅ AssetMapper CSS (le vrai link tag) #}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link href="{{ asset('css/accessibility.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    {% block stylesheets %}{% endblock %}
  </head>
  <body>
    {% include 'partials/_navbar.html.twig' %}
    {% block body %}{% endblock %}


    {# ✅ Importmap (charge assets/app.js) #}
    {% block javascripts %}
      {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
    
    {# Bootstrap JS (optionnel) #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('js/accessibility.js') }}"></script>
    <twig:AccessibilityMenu />
  </body>
</html>
