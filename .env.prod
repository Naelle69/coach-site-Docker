APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change_me_in_prod

# DB prod (exemple MariaDB)
DATABASE_URL="mysql://user:password@mariadb:3306/app?charset=utf8mb4"

# Mail prod (SMTP fournisseur)
MAILER_DSN=smtp://user:pass@smtp.provider:587

# Messenger (si utilisé en async en prod)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
